# Merged on top of every base config (defconfig, Armbian's, or yours).
# The release suffix comes from KERNEL_LOCALVERSION, not from the config.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# /proc/config.gz - lets you grab the exact config from any board later
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# zram swap
CONFIG_ZRAM=m
CONFIG_CRYPTO_ZSTD=y

# no debug info: much faster build, no 500 MB -dbg package
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
