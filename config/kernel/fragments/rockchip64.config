# rockchip64 family: things the board must have built in to reach the root filesystem
# and the network without relying on initramfs module selection.
CONFIG_ARCH_ROCKCHIP=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_EXT4_FS=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_REALTEK_PHY=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_SERIAL_8250_DW=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_CPUFREQ_DT=y

# On-board Realtek SDIO Wi-Fi + UART Bluetooth combos (ROCK Pi S: RTL8723DS).
# Modules, so boards without the chip don't pay for it. Firmware: firmware-realtek.
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8723DS=m
CONFIG_BT_HCIUART_RTL=y
